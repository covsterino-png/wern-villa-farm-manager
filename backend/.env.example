TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# EID Cymru movement reporting. Obtain the endpoint and token from EID Cymru,
# then set these only in the deployed environment. CPH numbers are managed in
# Administration > EID Cymru Holdings.
EID_CYMRU_API_URL=
EID_CYMRU_API_TOKEN=

# Authentication secrets. Set these in the backend environment and never commit real values.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_SETUP_KEY=one-time-key-for-first-password-setup
DAVID_PASSWORD=replace-with-david-password
GEMMA_PASSWORD=replace-with-gemma-password
WEBAUTHN_RP_ID=wern-villa-frontend.onrender.com
WEBAUTHN_ORIGIN=https://wern-villa-frontend.onrender.com

# Existing database and service settings
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@example.com

# Home Assistant integration for outbuilding lighting/cameras. This backend
# runs on Render, not on your home LAN, so HOMEASSISTANT_URL must be your
# Nabu Casa remote URL (Settings > Home Assistant Cloud > Remote Control,
# looks like https://xxxxxxxx.ui.nabu.casa), not homeassistant.local.
# HOMEASSISTANT_TOKEN is a long-lived access token (Profile > Security).
HOMEASSISTANT_URL=https://xxxxxxxx.ui.nabu.casa
HOMEASSISTANT_TOKEN=

# Home Assistant (and other machine integrations) call into this app's own
# API under /api/home-assistant/* using an X-API-Key header. Keys are
# generated and stored (hashed) via POST /home-assistant/api-keys as David;
# no env var is needed for this direction of the integration.
